{
  "extends": "../.config/typescript/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["../packages/react/src/*"],
      "@rari/logger": ["../packages/logger/src/index"],
      "@rari/use-cache/runtime/*": ["../packages/use-cache/src/runtime/*"],
      "@rari/use-cache": ["../packages/use-cache/src/index"],
      "@rari/core": ["../packages/core/src/index"],
      "@rari/core/*": ["../packages/core/src/*"],
      "@rari/cli/*": ["../packages/rari/src/cli/*"],
      "@rari/*": ["../packages/react/src/*"]
    },
    "types": ["node", "react"]
  },
  "include": ["**/*.ts", "**/*.tsx", "../packages/react/src/ambient.d.ts"]
}
